# Public URL (used for canonical URLs, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://muhamedstore.com

# Where orders/messages are stored (JSON files). Must be a persistent, writable directory.
DATA_DIR=./var

# Email — Titan Mail (see README "Email"). Without SMTP_USER + SMTP_PASS, emails are only logged.
# Inbox that receives order + contact-form notifications:
STORE_EMAIL=info@muhamedstore.com
# Display name for outgoing mail. The From address is always SMTP_USER (Titan requires it).
MAIL_FROM="Muha Meds Store"
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
# Full Titan mailbox address and its password (set the real password only in .env.local / your host):
SMTP_USER=info@muhamedstore.com
SMTP_PASS=

